{
  "name": "sp-host-mcp-server",
  "version": "1.0.0",
  "description": "SmartPerf Host MCP Server - trace analysis tools for coding assistants",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outdir=dist --format=cjs --sourcemap --loader:.sql=text --external:better-sqlite3 --external:ws",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.7.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}

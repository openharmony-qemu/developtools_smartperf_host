{
  "name": "memory-leak-hunt",
  "description": "Memory leak hunting: triage → memory detail → native hook analysis.",
  "steps": [
    {
      "id": "triage",
      "tool": "triage_memory"
    },
    {
      "id": "detail",
      "tool": "memory_detail",
      "argsMapping": {
        "ipid": "${triage.content.0.ipid}"
      }
    },
    {
      "id": "native_hook",
      "tool": "native_hook_detail",
      "argsMapping": {
        "ipid": "${triage.content.0.ipid}"
      }
    }
  ]
}
